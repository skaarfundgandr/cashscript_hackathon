# Private keys (64-char hex, no 0x prefix)
# Export from your Paytaca wallet for chipnet testing.
# Defaults (0x00...01–05) are well-known test keys with no funds.
MERCHANT_PRIVATE_KEY=
COURIER_A_PRIVATE_KEY=
COURIER_B_PRIVATE_KEY=
REGISTRY_PRIVATE_KEY=
RECIPIENT_PRIVATE_KEY=

# shop-backend: URL of the custody service
# Real backend: http://localhost:3000 | Fixture: http://localhost:3002
CUSTODY_URL=http://localhost:3002

# shop-backend: SQLite database path
SHOP_DB=shop.db

# frontend: backend API URL (baked at build time for Docker)
VITE_API_URL=http://localhost:3000
